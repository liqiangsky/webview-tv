<?xml version="1.0" encoding="utf-8"?>
<!--
  左列「频道信息」（纯展示，不参与焦点/方向键）：
  状态药丸 → 频道名 → 在播节目 → 时段与剩余 → 进度线 → 下一档。
  整列从上到下一眼读完，不需要按键走到这里。
  底色由 panel_overlay 的那个大容器给，这一列只留自己的内边距。
  系统时间和日期挪到右列顶部：这一列窄，频道名和节目单稍长就挤到底边，
  再挤也不该把时钟顶出屏幕。
  频道名开自适应字号（宽度固定 + 限死一行，长到装不下整体缩字号不截断）；
  节目单两档不锁行数和高度，有多长排多少行——下一档的开档时间挂在「接下来」后面，
  省下的正是原来被挤到第二行的那几个字。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/infoPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="false"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <!-- 电视只有光标没有鼠标，必须说清这是“在播的台”还是“正在预览的台” -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/infoState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/info_state_preview"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:textColor="#E6FFFFFF"
            android:textSize="13sp" />

        <!-- 顺序：播放状态 → 来源 → 清晰度。两个都是可选信息，空着就不占位 -->
        <TextView
            android:id="@+id/infoSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/info_state_preview"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/infoQuality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/info_state_preview"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 自适应字号要有个定死的框才知道该缩到多大，所以频道名给死高度 + 限死一行：
         名字长（带括号副名这类）整体缩字号，不再往下顶 -->
    <TextView
        android:id="@+id/infoTitle"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:autoSizeMaxTextSize="30sp"
        android:autoSizeMinTextSize="18sp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <!-- 节目单两档不锁行数和高度：有多长就排多少行，底部那块 Space 先被吃掉 -->
    <TextView
        android:id="@+id/infoNow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="2dp"
        android:textColor="#D9FFFFFF"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/infoRemain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#8E8E93"
        android:textSize="14sp" />

    <!-- 节目进度：整宽一条细线。没对上节目单时，进度线/分隔/「接下来」一起收掉，
         只剩一句占位文案，不留空档 -->
    <FrameLayout
        android:id="@+id/guideTrack"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="18dp"
        android:background="#26FFFFFF">

        <View
            android:id="@+id/infoProgress"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="#FFFFFF" />
    </FrameLayout>

    <View
        android:id="@+id/guideDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:background="#14FFFFFF" />

    <TextView
        android:id="@+id/guideNextLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:maxLines="1"
        android:textColor="#6C6C70"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/infoNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="2dp"
        android:textColor="#B3FFFFFF"
        android:textSize="16sp" />

    <!-- 时钟挪去右列，这里只留一块空白把上面顶住 -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
