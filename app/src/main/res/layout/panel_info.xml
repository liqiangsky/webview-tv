<?xml version="1.0" encoding="utf-8"?>
<!--
  左列「频道信息」（纯展示，不参与焦点/方向键）：
  状态药丸 → 频道名 → 在播节目 → 时段与剩余 → 进度线 → 下一档 → 底部系统时间。
  整列从上到下一眼读完，不需要按键走到这里。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/infoPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/info_card_bg"
    android:clickable="true"
    android:focusable="false"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="20dp"
    android:paddingEnd="22dp"
    android:paddingBottom="20dp">

    <!-- 电视只有光标没有鼠标，必须说清这是“在播的台”还是“正在预览的台” -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/infoState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/info_state_preview"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:textColor="#E6FFFFFF"
            android:textSize="13sp" />

        <!-- 清晰度来自频道表第四列（默认 HD） -->
        <TextView
            android:id="@+id/infoQuality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/info_state_preview"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:textColor="#99FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/infoTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/infoNow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#D9FFFFFF"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/infoRemain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#8E8E93"
        android:textSize="14sp" />

    <!-- 节目进度：整宽一条细线 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="18dp"
        android:background="#26FFFFFF">

        <View
            android:id="@+id/infoProgress"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="#FFFFFF" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:background="#14FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="接下来"
        android:textColor="#6C6C70"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/infoNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="#B3FFFFFF"
        android:textSize="16sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/infoClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/infoDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:textColor="#80FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
