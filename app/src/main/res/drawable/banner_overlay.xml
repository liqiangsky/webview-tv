<?xml version="1.0" encoding="utf-8"?>
<!-- 横幅覆盖层：网格纹理 + 六格播放标 + INWEB 字标。
     全部纯色，不能带 gradient —— 带渐变的矢量会被 aapt 移到 v24，API 21-23 的设备就拿不到。
     排版按 320x180 定死：标志占左三分之一，字标从 165 起，两边各留 30 以上。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <!-- 网格：只留竖线，极淡。横线会从标志中间穿过，看着像划了一道 -->
    <path
        android:pathData="M40,0 V180 M120,0 V180 M200,0 V180 M280,0 V180"
        android:strokeWidth="1"
        android:strokeColor="#149CC8FF" />

    <!-- 左侧标志：与图标前景同一套几何，等比放到 113dp -->
    <group
        android:scaleX="1.05"
        android:scaleY="1.05"
        android:translateX="28"
        android:translateY="33">
        <path
            android:fillColor="#F4F8FF"
            android:pathData="M34,30 h6 a4,4 0 0 1 4,4 v6 a4,4 0 0 1 -4,4 h-6 a4,4 0 0 1 -4,-4 v-6 a4,4 0 0 1 4,-4 z" />
        <path
            android:fillAlpha="0.92"
            android:fillColor="#F4F8FF"
            android:pathData="M34,48 h6 a4,4 0 0 1 4,4 v6 a4,4 0 0 1 -4,4 h-6 a4,4 0 0 1 -4,-4 v-6 a4,4 0 0 1 4,-4 z" />
        <path
            android:fillAlpha="0.84"
            android:fillColor="#F4F8FF"
            android:pathData="M34,66 h6 a4,4 0 0 1 4,4 v6 a4,4 0 0 1 -4,4 h-6 a4,4 0 0 1 -4,-4 v-6 a4,4 0 0 1 4,-4 z" />
        <path
            android:fillColor="#A8ECFF"
            android:pathData="M52,39 h6 a4,4 0 0 1 4,4 v6 a4,4 0 0 1 -4,4 h-6 a4,4 0 0 1 -4,-4 v-6 a4,4 0 0 1 4,-4 z" />
        <path
            android:fillAlpha="0.92"
            android:fillColor="#A8ECFF"
            android:pathData="M52,57 h6 a4,4 0 0 1 4,4 v6 a4,4 0 0 1 -4,4 h-6 a4,4 0 0 1 -4,-4 v-6 a4,4 0 0 1 4,-4 z" />
        <path
            android:fillColor="#46C2FF"
            android:pathData="M70,48 h6 a4,4 0 0 1 4,4 v6 a4,4 0 0 1 -4,4 h-6 a4,4 0 0 1 -4,-4 v-6 a4,4 0 0 1 4,-4 z" />
    </group>

    <!-- 字标 INWEB：几何无衬线，cap 高 30、笔画 5.5、字距 9，矢量保证任何尺寸都锐利 -->
    <path
        android:pathData="M168,76 V106 M183,106 V76 L198,106 V76 M207,76 L212.5,106 L218,86 L223.5,106 L229,76 M251,76 H238 V106 H251 M238,91 H249 M260,76 V106 M260,76 H268 a7.5,7.5 0 0 1 0,15 H260 M260,91 H269 a7.5,7.5 0 0 1 0,15 H260"
        android:strokeWidth="5.5"
        android:strokeColor="#F4F8FF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
