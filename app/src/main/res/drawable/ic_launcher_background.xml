<?xml version="1.0" encoding="utf-8"?>
<!-- 图标底色：深海军蓝斜向渐变，右下角偏蓝，左上偏黑，跟启动页/黑幕同一个色系 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#FF070C17" />
                <item android:offset="0.55" android:color="#FF10224A" />
                <item android:offset="1" android:color="#FF1E4EA8" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- 中间偏上一点冷色光晕，避免纯平渐变的呆板 -->
