<?xml version="1.0" encoding="utf-8"?>
<!-- 图标底色：深海军蓝斜向渐变，与播放器黑幕/启动页同一色系。
     前景是几块白卡片，底色要够深才能把卡片衬出来，所以起点压得比旧版更黑。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="10"
                android:startY="4"
                android:endX="100"
                android:endY="106"
                android:type="linear">
                <item android:offset="0" android:color="#FF05080F" />
                <item android:offset="0.5" android:color="#FF0C1B3A" />
                <item android:offset="1" android:color="#FF1B4A9C" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- 左上角一道极淡的斜向高光，像屏幕反光，避免整块底色发闷 -->
    <path android:pathData="M-10,-10 L58,-10 L10,54 L-10,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="40"
                android:startY="-10"
                android:endX="60"
                android:endY="60"
                android:type="linear">
                <item android:offset="0" android:color="#1A9CC8FF" />
                <item android:offset="1" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- 右下偏中心的冷色光晕，把视线往播放键那侧带 -->
    <path android:pathData="M54,54m-46,0a46,46 0 1,0 92,0a46,46 0 1,0 -92,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="62"
                android:centerY="62"
                android:gradientRadius="48">
                <item android:offset="0" android:color="#335AA8FF" />
                <item android:offset="1" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
